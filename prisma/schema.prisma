// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String   @id @default(cuid())
  title        String
  date         String
  description  String
  image        String
  details      String?
  location     String?
  participants String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Period {
  id        Int      @id @default(autoincrement())
  period    Int      @unique
  year      Int
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GradeLevel {
  CLASS_10
  CLASS_11
  CLASS_12
}

enum SubjectType {
  SPLDV
  MATRIKS
  KALKULUS
  ALJABAR
  GEOMETRI
  TRIGONOMETRI
  STATISTIKA
  PELUANG
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id          String      @id @default(cuid())
  content     String
  grade       GradeLevel
  subject     SubjectType
  difficulty  Difficulty
  solution    String?
  options     Option[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Option {
  id          String   @id @default(cuid())
  content     String
  isCorrect   Boolean  @default(false)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
}

model Member {
  id        String   @id @default(cuid())
  name      String
  ig        String
  image     String?
  position  String
  period    Period   @relation(fields: [periodId], references: [id])
  periodId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
