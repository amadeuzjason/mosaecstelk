generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String   @id @default(cuid())
  title        String
  date         String
  description  String
  image        String
  details      String?
  location     String?
  participants String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Period {
  id        Int      @id @default(autoincrement())
  period    Int      @unique
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     String?
  members   Member[]
}

model Question {
  id         String     @id @default(cuid())
  content    String
  grade      GradeLevel
  difficulty Difficulty
  solution   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  image      String?
  subject    String
  options    Option[]
}

model Option {
  id         String   @id @default(cuid())
  content    String
  image      String?
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Member {
  id        String   @id @default(cuid())
  name      String
  ig        String
  image     String?
  position  String
  periodId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  period    Period   @relation(fields: [periodId], references: [id])
}

enum GradeLevel {
  CLASS_10
  CLASS_11
  CLASS_12
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
